# Monorepo root — applies to both savora/ and savora-backend/

# dependencies
**/node_modules/

# secrets & env (NEVER commit real .env — examples are fine)
**/.env
**/.env.*
!**/.env.example
*.keystore
*.jks
**/google-services.json
**/GoogleService-Info.plist

# build / tooling output
**/.expo/
**/dist/
**/web-build/
**/.vs/
*.tsbuildinfo

# native
savora/ios/
**/.gradle/
**/build/

# misc
.DS_Store
npm-debug.*
